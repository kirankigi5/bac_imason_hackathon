LLM_PROVIDER=local
# Select openai, openrouter or gemini and an account-supported model to enable AI.
LLM_MODEL=
LLM_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
# OpenRouter requires a provider-qualified model ID. GOOGLE_API_KEY is a Gemini alias.
MAP_TOKEN=
# Paths are resolved from apps/web when running the Next.js application.
DATA_DIR=../../data/feature_store
PROJECT_DB_PATH=../../data/projects/projects.sqlite
# Used only by the optional verification scripts.
APP_URL=http://localhost:3000
# Active LLM verification is development-only by default.
ALLOW_LLM_VERIFICATION=0

# Optional pipeline key, exported in the shell; public ACS bulk tables work without it.
CENSUS_API_KEY=

# Railway: set LLM_PROVIDER=gemini and an account-supported LLM_MODEL in Variables.
# Mount the persistent volume at /app/runtime; replace the local paths above with:
# DATA_DIR=/app/runtime/feature_store
# PROJECT_DB_PATH=/app/runtime/projects/projects.sqlite
RUNTIME_ROOT=/app/runtime
RUNTIME_DATA_URL=
# Required for first-start download; use the locally generated archive checksum.
RUNTIME_DATA_SHA256=
